{
  "name": "@wrs/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "npm run prisma:generate && tsc --noEmit",
    "env:check": "tsx src/config/check-env.ts",
    "prisma:validate": "prisma validate --config prisma.generate.config.ts",
    "prisma:generate": "prisma generate --config prisma.generate.config.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "verify:database": "tsx scripts/verify-database.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "argon2": "0.44.0",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "pg": "8.23.1",
    "redis": "5.12.1",
    "zod": "4.6.7",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "4.1.12",
    "typescript": "5.9.3",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.72.1"
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=11.6.2 <12"
  }
}
