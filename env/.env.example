NODE_ENV=development
DEPLOYMENT_MODE=local
PORT=3000
APP_ORIGIN=http://localhost:5175

# Fill credentials yourself. Percent-encode passwords in connection URLs.
DATABASE_URL=
REDIS_URL=
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
ANONYMOUS_SESSION_SECONDS=900
REDIS_NAMESPACE=wrs:dev:laptop
# Empty means no trusted proxy. HTTPS behind a local gateway may use loopback.
TRUST_PROXY=

POSTGRES_USER=warehouse_dev
POSTGRES_DB=warehouse_development
POSTGRES_PASSWORD=
POSTGRES_PORT=55450
REDIS_PASSWORD=
REDIS_PORT=56400

SEED_SUPERVISOR_NAME=
SEED_SUPERVISOR_EMAIL=
SEED_SUPERVISOR_PASSWORD=
SEED_OPERATOR_NAME=
SEED_OPERATOR_EMAIL=
SEED_OPERATOR_PASSWORD=

# npm run dev only targets this existing laptop development project.
COMPOSE_PROJECT_NAME=wrs-development-laptop
