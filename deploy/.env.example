# Copy locally to deploy/.env; never commit filled credentials.
COMPOSE_PROJECT_NAME=wrs-local
# Relative to deploy/compose.yaml, or use an absolute frontend checkout path.
FRONTEND_CONTEXT=../../frontend
WEB_PORT=8080
APP_ORIGIN=http://localhost:8080
APP_SUBNET=172.29.70.0/24
GATEWAY_IP=172.29.70.10
DEPLOYMENT_MODE=local
SESSION_COOKIE_SECURE=false
REDIS_NAMESPACE=wrs
POSTGRES_USER=warehouse
POSTGRES_DB=warehouse
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Internal service hosts, not localhost; percent-encode credentials in URLs.
DATABASE_URL=
REDIS_URL=
SESSION_SECRET=
SEED_SUPERVISOR_NAME=Supervisor
SEED_SUPERVISOR_EMAIL=
SEED_SUPERVISOR_PASSWORD=
SEED_OPERATOR_NAME=Operator
SEED_OPERATOR_EMAIL=
SEED_OPERATOR_PASSWORD=
